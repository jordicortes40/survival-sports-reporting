#setwd(getwd())
dd <- read.csv2("../Dades/shidr.csv")
dd$S<-as.factor(dd$SHIDR)
library(car)
library(emmeans)
library(multcomp)
View(dd)
mlf<-lm(FS~S*R,dd)
Anova(mlf)
emmeans(mlf,~S|R)
plot(mlf,which=1)
abline(h=0,lt=2)
mla<-lm(FS~S+R,dd)
Anova(mla)
emmeans(mla,~S|R)
plot(mla,which=1)
abline(h=0,lt=2)
#Factors
dd$S<-factor(dd$S)
#Gràfica
scatterplot(FS~R|S,smooth=F,data=dd)
