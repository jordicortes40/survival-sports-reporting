tab_mg_cox
tab_mg_cox <- d %>%
tabyl(main_goal, get('cox')) %>%
adorn_totals("row") %>%
adorn_percentages("row") %>%
adorn_pct_formatting(digits = 1) %>%
adorn_ns()
tab_mg_cox <- d %>%
tabyl(main_goal, !!sym('cox')) %>%
adorn_totals("row") %>%
adorn_percentages("row") %>%
adorn_pct_formatting(digits = 1) %>%
adorn_ns()
tab_mg_cox
my_tab <- function(var1, var2){
tab <- d %>%
tabyl(!!sym(var1), !!sym(var2)) %>%
adorn_totals("row") %>%
adorn_percentages("row") %>%
adorn_pct_formatting(digits = 1) %>%
adorn_ns()
tab
}
my_tab('main_goal','cox')
d$s
d$sport
my_tab('sport','kaplan_meier')
