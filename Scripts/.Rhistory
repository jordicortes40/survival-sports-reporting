HR_e1      = HR_e1    , HR_e2    = HR_e2,
beta_e1    = beta_e1  , beta_e2  = beta_e2,
rho        = rho      , rho_type = rho_type,
copula     = copula   , case     = case,
alpha      = alpha    , power    = power,
ss_formula = ss_formula)
##-- Sample size
are_res <- ARE_tte(p0_e1      = p0_e1    , p0_e2    = p0_e2,
HR_e1      = HR_e1    , HR_e2    = HR_e2,
