library(conjoint)
library(AlgDesign)
##-- Data
experiment <- expand.grid(price   = c("low","medium","high"),
variety = c("black","green","red"),
kind    = c("bags","granulated","leafy"),
aroma   = c("yes","no"))
##-- Full design
design <- caFactorialDesign(data=experiment, type="full")
design
design.encoded <- caEncodedDesign(design)
design.encoded
cor(design.encoded) # Orthogonal
design1 <- caFactorialDesign(data=experiment, type="fractional", cards=27)
design1
design.encoded1 <- caEncodedDesign(design1)
design.encoded1
cor(design.encoded1)
design2 <- caFactorialDesign(data=experiment, type="fractional", cards=16)
design2
design.encoded2 <- caEncodedDesign(design2)
design.encoded2
cor(design.encoded2)
design3 <- caFactorialDesign(data=experiment, type="orthogonal", cards=16)
design3
design.encoded3 <- caEncodedDesign(design3)
design.encoded3       ##-- Opps. It does not have 16 products
cor(design.encoded3)
##-- Factorial design
dat  <- gen.factorial(levels=2, nVars=5, factors="all", varNames=LETTERS[1:5])
dat
des1 <- optFederov(data=dat, nTrials=16, approximate=FALSE)
##-- Different measures of the design efficiency (variance)
des1$D    # The kth root of the generalized variance --> 100% Efficient
des1$design
cor(sapply(des1$design, as.numeric))
des2 <- optFederov(data=dat, nTrials=10, approximate=FALSE)
des2$design
cor(sapply(des2$design, as.numeric))
dat <- gen.factorial(levels=3, nVars=3, factors="all", varNames=LETTERS[1:3])
dat
des3 <- optFederov(data=dat, nTrials=16, approximate=FALSE)
des3$design
cor(sapply(des3$design, as.numeric))
dat <- gen.factorial(levels=c(2,3,4), nVars=3, factors="all", varNames=LETTERS[1:3])
dat
des4 <- optFederov(data=dat, nTrials=16, approximate=FALSE)
des4$design
cor(sapply(des4$design, as.numeric))
N <- 10:24
Eff <- c()
for(n in N){
des <- optFederov(data=dat, nTrials=n, approximate=FALSE, nRepeats = 100)
Eff[N==n] <- des$D
}
plot(N,Eff,type='b')
